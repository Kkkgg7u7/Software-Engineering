# =====================================================================
# 前端环境变量（Vite）。所有变量必须以 VITE_ 开头才会注入前端代码。
# 复制为 .env.local 后按本地环境修改（.env.local 已被 .gitignore 忽略）。
# =====================================================================

# ---------------------------------------------------------------------
# VITE_API_BASE —— REST 基础路径
#
#   /api（默认，推荐）
#       相对路径。开发期由 Vite 代理转发到后端；生产由 Nginx 或后端同源托管。
#       只要前端和后端通过同一个地址访问（同源 + 反代），就用这个，不用改。
#
#   http://192.168.1.23:8080/api
#       绝对地址。前端与后端"分开部署、中间没有反向代理"时使用。
#       注意：此时浏览器会发起跨域请求，后端必须放行该来源
#       （默认配置已放行 192.168.*.* / 10.*.*.* / 172.16~31.*.* 等私网网段）。
#
#   ""（空字符串）
#       直接打到当前源，不追加任何前缀。仅在后端本身就挂在根路径时使用。
# ---------------------------------------------------------------------
VITE_API_BASE=/api

# ---------------------------------------------------------------------
# VITE_WS_URL —— WebSocket / STOMP 地址
#
#   留空（默认，推荐）
#       自动使用"当前页面地址"推导：协议跟随页面（https -> wss），
#       host 与端口也跟随页面。因此无论是
#       http://localhost:5173 / http://192.168.1.23:5173 / https://xxx.trycloudflare.com，
#       都不需要重新构建，别人用自己电脑打开页面就能自动连上正确的后端。
#
#   仅当前端与后端不同源、且没有反向代理时才需要显式指定，例如：
#       VITE_WS_URL=ws://192.168.1.23:8080/ws
#
#   因此"别人用自己的电脑连进来"时，前端不需要改任何配置，也不用重新构建。
# ---------------------------------------------------------------------
VITE_WS_URL=

# ---------------------------------------------------------------------
# VITE_USE_SOCKJS —— 是否用 SockJS 兜底传输
#
#   原生 WebSocket 被中间设备（某些公司代理 / 老版本防火墙）拦截、页面反复重连时，
#   设为 true 让 STOMP 走 SockJS 的 xhr-streaming / xhr-polling 传输。
#   代价是延迟略高，能连通时不必开。
# ---------------------------------------------------------------------
VITE_USE_SOCKJS=false
