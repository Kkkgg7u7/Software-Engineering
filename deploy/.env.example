# =====================================================================
# deploy/.env.example —— Docker Compose 一键部署的全部可配置变量
#
# 用法：
#   cp .env.example .env      # Windows PowerShell: Copy-Item .env.example .env
#   # 按需修改 .env（尤其是 MYSQL_ROOT_PASSWORD 与 WEREWOLF_JWT_SECRET）
#   docker compose up -d --build
#
# 说明：
#   * .env 与 docker-compose.yml 放在同一目录（deploy/），compose 会自动读取；
#   * .env 已被 .gitignore 忽略，不要提交真实密码；
#   * 每个变量的默认值与 docker-compose.yml 中 ${VAR:-默认值} 一致，
#     不写这一项也能跑起来。
# =====================================================================

# ----------------------------------------------------------- 端口映射 --
# 前端（Nginx）对外端口：浏览器访问 http://localhost:<WEB_PORT>
WEB_PORT=80
# 后端对外端口（便于直接 curl /api/health 排查问题）
BACKEND_PORT=8080

# ------------------------------------------------------------- MySQL --
# root 密码：仅用于容器内部初始化与 mysqladmin 健康检查
MYSQL_ROOT_PASSWORD=
# 业务库名（database/schema.sql 里也是 werewolf）
MYSQL_DATABASE=werewolf
# 应用使用的数据库账号（容器启动时会自动创建并授权）
MYSQL_USER=werewolf
MYSQL_PASSWORD=

# --------------------------------------------------------- 后端安全 ----
# JWT 签名密钥：至少 32 字节，生产环境务必替换成随机值
# 生成示例：openssl rand -base64 48
WEREWOLF_JWT_SECRET=
# CORS 允许的来源（英文逗号分隔）。同源部署（Nginx 反代 /api）时填对外访问源即可；
# 若前端直接用其它域名/端口访问后端，必须在这里补上，否则浏览器会拦截。
WEREWOLF_CORS_ORIGINS=https://jiujiu.example.com

# ------------------------------------------------------------ AI NPC --
# 总开关：默认 false —— 基础功能（P0 核心闭环）不依赖任何外部大模型。
# 一局 4 人完全由真人浏览器窗口完成即可。
WEREWOLF_AI_ENABLED=false
# 只有把 WEREWOLF_AI_ENABLED 设为 true、并配置了 WEREWOLF_AI_API_KEY，
# 才会真正调用外部 LLM；未配置 Key 时 AI 座位自动降级为“规则 AI”（零外部依赖）。
WEREWOLF_AI_API_KEY=
# OpenAI 兼容的 /chat/completions 服务地址与模型
#   DeepSeek: https://api.deepseek.com          + deepseek-chat
#   OpenAI:   https://api.openai.com/v1         + gpt-4o-mini
#   Ollama:   http://host.docker.internal:11434/v1 + qwen2.5:7b
WEREWOLF_AI_BASE_URL=https://api.deepseek.com
WEREWOLF_AI_MODEL=deepseek-chat

# ------------------------------------------------------- 运行时调优 ----
# JVM 内存参数（JAVA_TOOL_OPTIONS 会被 JVM 自动读取）
JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m
# 容器时区（与 application.yml 的 jackson.time-zone 保持一致）
TZ=Asia/Shanghai

# --------------------------------------------------- 前端构建期变量 ----
# 这些是 Vite 构建期变量（会打进静态产物），改了必须重新 build 镜像
# REST 基础路径：同源部署保持 /api
VITE_API_BASE=/api
# WebSocket 地址：留空 = 按当前页面 host 自动推导 ws(s)://<host>/ws（推荐）
# 仅当前后端不同源（例如静态站点 + 独立后端域名）时才需要填，如 wss://api.example.com/ws
VITE_WS_URL=
# 代理环境不支持原生 WebSocket 时设为 true（走 SockJS 兜底）
VITE_USE_SOCKJS=false

# =====================================================================
# 附：不用 Docker 而用本机 MySQL 时（SPRING_PROFILES_ACTIVE=mysql），
#     后端读取的是下面这几个变量（默认值与 application-mysql.yml 一致）：
#   SPRING_PROFILES_ACTIVE=mysql
#   MYSQL_HOST=127.0.0.1
#   MYSQL_PORT=3306
#   MYSQL_DATABASE=werewolf
#   MYSQL_USER=werewolf
#   MYSQL_PASSWORD=
# 详见 database/README.md 与 deploy/README.md 的“方式 B”。
# =====================================================================

# JSON ICE configuration, [] supports local network only. Use real STUN/TURN infrastructure for Internet audio.
JIUJIU_VOICE_ICE_SERVERS=[]
